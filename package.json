{
	"name": "n8n-nodes-jira-poll-trigger",
	"version": "0.1.0",
	"description": "Jira Cloud issue and comment polling trigger for n8n",
	"license": "MIT",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"jira",
		"trigger"
	],
	"author": {
		"name": "pemontto",
		"email": "pemontto@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pemontto/n8n-nodes-jira-poll-trigger.git"
	},
	"bugs": {
		"url": "https://github.com/pemontto/n8n-nodes-jira-poll-trigger/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run build && node --test tests/*.test.js",
		"package:check": "node scripts/package-check.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.map"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [],
		"nodes": [
			"dist/nodes/JiraPollTrigger/JiraPollTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.46.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"homepage": "https://github.com/pemontto/n8n-nodes-jira-poll-trigger#readme"
}
